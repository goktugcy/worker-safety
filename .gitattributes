# Normalise line endings on checkin.
* text=auto eol=lf

*.php diff=php
*.md  diff=markdown

# Keep the CLI entry point executable and LF-terminated on every platform.
bin/worker-safety text eol=lf

# Files that do not belong in a `composer require --dev` install.
/.editorconfig        export-ignore
/.gitattributes       export-ignore
/.gitignore           export-ignore
/.github/             export-ignore
/.php-cs-fixer.dist.php export-ignore
/composer.lock        export-ignore
/examples/            export-ignore
/phpstan.neon         export-ignore
/phpunit.xml          export-ignore
/tests/               export-ignore
