{
    "name": "goktugcy/worker-safety",
    "description": "Static analysis for PHP applications running on persistent workers. Detect cross-request state risks before they reach production.",
    "type": "library",
    "keywords": [
        "frankenphp",
        "laravel",
        "octane",
        "php",
        "roadrunner",
        "sarif",
        "static-analysis",
        "swoole",
        "worker"
    ],
    "homepage": "https://github.com/goktugcy/worker-safety",
    "license": "MIT",
    "authors": [
        {
            "name": "Worker Safety Contributors",
            "homepage": "https://github.com/goktugcy/worker-safety/graphs/contributors"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "ext-mbstring": "*",
        "nikic/php-parser": "^5.3",
        "symfony/console": "^6.4 || ^7.0",
        "symfony/yaml": "^6.4 || ^7.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "laravel/framework": "^12.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5 || ^12.0"
    },
    "suggest": {
        "laravel/framework": "Registers `php artisan worker-safety:scan` through package discovery. Verified against Laravel 11 and 12."
    },
    "autoload": {
        "psr-4": {
            "WorkerSafety\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WorkerSafety\\Tests\\": "tests/"
        },
        "exclude-from-classmap": [
            "/tests/Fixtures/"
        ]
    },
    "bin": [
        "bin/worker-safety"
    ],
    "config": {
        "platform": {
            "php": "8.2.0"
        },
        "sort-packages": true,
        "optimize-autoloader": true,
        "policy": {}
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        },
        "laravel": {
            "providers": [
                "WorkerSafety\\Integration\\Laravel\\WorkerSafetyServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-text",
        "analyse": "phpstan analyse --memory-limit=512M",
        "lint": "php-cs-fixer fix --dry-run --diff",
        "lint:fix": "php-cs-fixer fix",
        "ci": [
            "@lint",
            "@analyse",
            "@test"
        ]
    },
    "scripts-descriptions": {
        "test": "Run the PHPUnit test suite.",
        "analyse": "Run PHPStan static analysis at max level.",
        "lint": "Check coding style with PHP-CS-Fixer (no changes written).",
        "lint:fix": "Fix coding style with PHP-CS-Fixer."
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
